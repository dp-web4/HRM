 #include "llama.h"
 #include "log.h"
 
+// --- routing instrumentation (McNugget: test the step-convergent expert working set premise) ---
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <mutex>
+#include <set>
+#include <vector>
+int g_diff_route_step = -1;                 // set by diffusion.cpp before each decode
+static FILE * g_route_fp = nullptr;
+static std::mutex g_route_mtx;
+static bool route_cb(struct ggml_tensor * t, bool ask, void * /*ud*/) {
+    const bool is_topk = t->name[0] && std::strncmp(t->name, "ffn_moe_topk", 12) == 0;
+    if (ask) return is_topk;                // observe only the router top-k selection nodes
+    if (!is_topk || !g_route_fp) return true;
+    if (t->buffer == nullptr) return true;  // not materialized -> skip
+    int il = -1; const char * d = std::strrchr(t->name, '-'); if (d) il = std::atoi(d + 1);
+    const int64_t n = ggml_nelements(t);
+    std::vector<int32_t> buf(n);            // local (thread-safe); cb may fire from compute threads
+    ggml_backend_tensor_get(t, buf.data(), 0, ggml_nbytes(t));
+    std::set<int32_t> distinct(buf.begin(), buf.end());
+    std::lock_guard<std::mutex> lk(g_route_mtx);
+    std::fprintf(g_route_fp, "%d,%d,%lld,%zu,", g_diff_route_step, il, (long long) n, distinct.size());
+    for (int e : distinct) std::fprintf(g_route_fp, "%d ", e);
+    std::fprintf(g_route_fp, "\n");
+    std::fflush(g_route_fp);
+    return true;
+}
