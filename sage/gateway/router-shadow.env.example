# Template — copy to router-shadow.env and edit paths for THIS machine.
# router-shadow.env itself is gitignored so per-machine paths don't
# collide across the fleet.
#
# Installed by scripts/router_pipeline_install.sh (Phase 0 Track 7)
# Sourced by sage/scripts/ensure_daemon.sh and raising wrappers.
# Remove with: scripts/router_pipeline_install.sh --uninstall
export SAGE_ROUTER_SHADOW=1
export SAGE_ROUTER_DATA_DIR=/path/to/this/machine/private-context/training-data/router
